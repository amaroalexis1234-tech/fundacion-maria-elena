# Copia este archivo a .env.local y completa los valores reales.

# Número de WhatsApp de la Fundación en formato internacional, solo dígitos.
# Ejemplo: 521234567890
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Endpoint al que se enviará el formulario de contacto (Resend, Formspree, API propia, etc.).
# Mientras esta variable no exista, el formulario mostrará un mensaje indicando
# que el envío aún no está configurado, en vez de simular un envío exitoso.
NEXT_PUBLIC_CONTACT_FORM_ENDPOINT=
